# development | test | production
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://zentia:zentia@localhost:5432/zentia?schema=public
TZ=America/Bogota
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Orígenes permitidos, separados por coma (obligatoria en production)
CORS_ORIGIN=http://localhost:5173
# Swagger en /api/docs (por defecto false en production)
DOCS_ENABLED=true
# false | true | número de proxies delante de la API
TRUST_PROXY=false
# Secreto HS256 del access token (mínimo 32 caracteres)
JWT_ACCESS_SECRET=
# Duración del access token y del refresh token (s, m, h o d)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Costo de bcrypt (4–15)
BCRYPT_COST=12
# Solo para el seed del primer administrador; se eliminan después del primer despliegue
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Jobs diarios en America/Bogota: vencimiento 00:05 y alertas 07:00
SCHEDULER_ENABLED=true
# Asistente de seguimiento (IA): gemini (defecto) o none; sin LLM_API_KEY se usa siempre la plantilla de respaldo
LLM_PROVIDER=gemini
# Modelo Flash vigente de Gemini; los nombres cambian, por eso se define aquí
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
LLM_TIMEOUT_MS=4000
# Seed de demostración en producción (solo si se necesita)
ALLOW_DEMO_SEED=false
# Carpeta de la web compilada que sirve Express en el mismo origen (la imagen Docker usa /app/web)
WEB_DIST_DIR=
