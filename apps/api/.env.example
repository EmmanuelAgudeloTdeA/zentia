# development | test | production
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://zentia:zentia@localhost:5432/zentia?schema=public
TZ=America/Bogota
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Orígenes permitidos, separados por coma
CORS_ORIGIN=http://localhost:5173
# Swagger en /api/docs (por defecto false en production)
DOCS_ENABLED=true
# false | true | número de proxies delante de la API
TRUST_PROXY=false
