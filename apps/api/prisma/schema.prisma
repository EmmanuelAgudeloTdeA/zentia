generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SELLER
  MANAGER
  ADMIN
}

model User {
  id                 String         @id @default(uuid()) @db.Uuid
  email              String         @unique
  name               String         @db.VarChar(120)
  passwordHash       String
  role               Role
  isActive           Boolean        @default(true)
  mustChangePassword Boolean        @default(true)
  passwordChangedAt  DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  refreshTokens      RefreshToken[]
  customers          Customer[]
  ownedQuotes        Quote[]        @relation("QuoteOwner")
  createdQuotes      Quote[]        @relation("QuoteCreator")
  quoteVersions      QuoteVersion[]
  quoteEvents        QuoteEvent[]
  interactions       Interaction[]
  notifications      Notification[]
  createdOrders      Order[]

  @@index([role, isActive])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id])
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  rotatedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

enum VatRate {
  GENERAL_19
  REDUCED_5
  EXEMPT
}

enum DocumentLocale {
  es
  en
}

/// Fila única (id = 1); los CHECK de rango viven en la migración.
model CompanySettings {
  id                   Int            @id @default(1)
  name                 String?        @db.VarChar(150)
  taxId                String?        @db.VarChar(30)
  address              String?        @db.VarChar(250)
  city                 String?        @db.VarChar(100)
  phone                String?        @db.VarChar(30)
  email                String?        @db.VarChar(150)
  website              String?        @db.VarChar(150)
  bankAccounts         String?        @db.Text
  commercialTerms      String?        @db.Text
  documentLocale       DocumentLocale @default(es)
  logoDataUrl          String?        @db.Text
  logoVersion          Int            @default(0)
  defaultVatRate       VatRate        @default(GENERAL_19)
  validityDays         Int            @default(15)
  discountLimitSeller  Decimal        @default(10) @db.Decimal(5, 2)
  discountLimitManager Decimal        @default(30) @db.Decimal(5, 2)
  discountLimitAdmin   Decimal        @default(30) @db.Decimal(5, 2)
  shippingTaxable      Boolean        @default(false)
  expiringAlertDays    Int            @default(3)
  followUpDays         Int            @default(5)
  coldStartThreshold   Int            @default(30)
  updatedAt            DateTime       @updatedAt
}

/// CHECK en la migración: phone IS NOT NULL OR email IS NOT NULL.
model Customer {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(150)
  nameKey      String        @db.VarChar(150)
  documentId   String        @unique @db.VarChar(20)
  phone        String?       @db.VarChar(15)
  email        String?       @db.VarChar(150)
  isActive     Boolean       @default(true)
  createdById  String        @db.Uuid
  createdBy    User          @relation(fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  quotes       Quote[]
  interactions Interaction[]

  @@index([isActive, nameKey])
  @@index([phone])
  @@index([email])
}

/// CHECK en la migración: price > 0.
model Product {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @db.VarChar(150)
  nameKey     String      @db.VarChar(150)
  category    String      @db.VarChar(80)
  categoryKey String      @db.VarChar(80)
  price       Decimal     @db.Decimal(15, 0)
  vatRate     VatRate
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  quoteItems  QuoteItem[]

  @@index([isActive, categoryKey])
  @@index([categoryKey])
  @@index([nameKey])
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  VOIDED
}

enum QuoteEventType {
  DISCOUNT_OVERRIDE
  EXPIRY_CHANGED
  REASSIGNED
  STATE_CHANGED
}

/// Contador del consecutivo; se incrementa con UPDATE ... RETURNING dentro de la transacción.
model QuoteSequence {
  key       String @id
  lastValue Int    @default(0)
}

/// CHECK en la migración: discountPct 0–100, shippingAmount >= 0, expiresAt obligatorio salvo en DRAFT y VOIDED.
model Quote {
  id              String         @id @default(uuid()) @db.Uuid
  number          Int            @unique
  customerId      String         @db.Uuid
  customer        Customer       @relation(fields: [customerId], references: [id])
  ownerId         String         @db.Uuid
  owner           User           @relation("QuoteOwner", fields: [ownerId], references: [id])
  createdById     String         @db.Uuid
  createdBy       User           @relation("QuoteCreator", fields: [createdById], references: [id])
  status          QuoteStatus    @default(DRAFT)
  discountPct     Decimal        @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal        @default(0) @db.Decimal(15, 0)
  shippingAmount  Decimal        @default(0) @db.Decimal(15, 0)
  shippingTaxable Boolean
  subtotal        Decimal        @db.Decimal(15, 0)
  linesVat        Decimal        @db.Decimal(15, 0)
  shippingVat     Decimal        @db.Decimal(15, 0)
  total           Decimal        @db.Decimal(15, 0)
  expiresAt       DateTime?      @db.Date
  sentAt          DateTime?
  firstSentAt     DateTime?
  approvedAt      DateTime?
  currentVersion  Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  items           QuoteItem[]
  versions        QuoteVersion[]
  events          QuoteEvent[]
  interactions    Interaction[]
  notifications   Notification[]
  order           Order?

  @@index([ownerId, status])
  @@index([ownerId, firstSentAt])
  @@index([status, expiresAt])
  @@index([firstSentAt])
  @@index([customerId])
  @@index([updatedAt])
}

/// CHECK en la migración: quantity > 0.
model QuoteItem {
  id          String  @id @default(uuid()) @db.Uuid
  quoteId     String  @db.Uuid
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String  @db.Uuid
  product     Product @relation(fields: [productId], references: [id])
  position    Int
  productName String  @db.VarChar(150)
  category    String  @db.VarChar(80)
  unitPrice   Decimal @db.Decimal(15, 0)
  vatRate     VatRate
  quantity    Decimal @db.Decimal(12, 2)
  lineAmount  Decimal @db.Decimal(15, 0)

  @@unique([quoteId, productId])
  @@index([quoteId])
}

model QuoteVersion {
  id              String   @id @default(uuid()) @db.Uuid
  quoteId         String   @db.Uuid
  quote           Quote    @relation(fields: [quoteId], references: [id])
  number          Int
  snapshot        Json
  changes         Json?
  customerRequest String?  @db.VarChar(1000)
  authorId        String   @db.Uuid
  author          User     @relation(fields: [authorId], references: [id])
  createdAt       DateTime @default(now())

  @@unique([quoteId, number])
}

model QuoteEvent {
  id        String         @id @default(uuid()) @db.Uuid
  quoteId   String         @db.Uuid
  quote     Quote          @relation(fields: [quoteId], references: [id])
  type      QuoteEventType
  /// null = sistema (job de vencimiento)
  actorId   String?        @db.Uuid
  actor     User?          @relation(fields: [actorId], references: [id])
  versionId String?        @db.Uuid
  note      String?        @db.VarChar(1000)
  data      Json
  createdAt DateTime       @default(now())

  @@index([quoteId, createdAt])
}

enum InteractionType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  OTHER
}

enum NotificationType {
  QUOTE_EXPIRING
  QUOTE_NO_FOLLOW_UP
}

/// Registro de solo agregar (sin updatedAt). CHECK en la migración: nota de 1 a 2000 caracteres.
model Interaction {
  id         String          @id @default(uuid()) @db.Uuid
  customerId String          @db.Uuid
  customer   Customer        @relation(fields: [customerId], references: [id])
  quoteId    String?         @db.Uuid
  quote      Quote?          @relation(fields: [quoteId], references: [id])
  type       InteractionType
  note       String          @db.VarChar(2000)
  occurredAt DateTime
  authorId   String          @db.Uuid
  author     User            @relation(fields: [authorId], references: [id])
  createdAt  DateTime        @default(now())

  @@index([customerId, occurredAt])
  @@index([quoteId, occurredAt])
}

/// Alerta para el dueño actual; el único (quoteId, type, referenceDate) evita duplicados por ciclo.
model Notification {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  user          User             @relation(fields: [userId], references: [id])
  quoteId       String           @db.Uuid
  quote         Quote            @relation(fields: [quoteId], references: [id])
  type          NotificationType
  params        Json
  referenceDate DateTime         @db.Date
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  @@unique([quoteId, type, referenceDate, userId])
  @@index([userId, readAt])
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
  CANCELLED
}

/// Un pedido por cotización (sin reconversión); el dueño es el de la cotización. CHECK en la migración.
model Order {
  id             String      @id @default(uuid()) @db.Uuid
  quoteId        String      @unique @db.Uuid
  quote          Quote       @relation(fields: [quoteId], references: [id])
  status         OrderStatus @default(PENDING)
  discountPct    Decimal     @db.Decimal(5, 2)
  discountAmount Decimal     @db.Decimal(15, 0)
  subtotal       Decimal     @db.Decimal(15, 0)
  linesVat       Decimal     @db.Decimal(15, 0)
  shippingAmount Decimal     @db.Decimal(15, 0)
  shippingVat    Decimal     @db.Decimal(15, 0)
  total          Decimal     @db.Decimal(15, 0)
  inProgressAt   DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?     @db.VarChar(500)
  createdById    String      @db.Uuid
  createdBy      User        @relation(fields: [createdById], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]

  @@index([status])
}

/// Copia fija de la línea de la cotización aprobada (RN-29).
model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @db.Uuid
  order       Order   @relation(fields: [orderId], references: [id])
  productId   String  @db.Uuid
  position    Int
  productName String  @db.VarChar(150)
  category    String  @db.VarChar(80)
  unitPrice   Decimal @db.Decimal(15, 0)
  vatRate     VatRate
  quantity    Decimal @db.Decimal(12, 2)
  lineAmount  Decimal @db.Decimal(15, 0)

  @@index([orderId])
}
