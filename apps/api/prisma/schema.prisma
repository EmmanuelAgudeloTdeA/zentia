generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SELLER
  MANAGER
  ADMIN
}

model User {
  id                 String         @id @default(uuid()) @db.Uuid
  email              String         @unique
  name               String         @db.VarChar(120)
  passwordHash       String
  role               Role
  isActive           Boolean        @default(true)
  mustChangePassword Boolean        @default(true)
  passwordChangedAt  DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  refreshTokens      RefreshToken[]
  customers          Customer[]
  ownedQuotes        Quote[]        @relation("QuoteOwner")
  createdQuotes      Quote[]        @relation("QuoteCreator")
  quoteVersions      QuoteVersion[]
  quoteEvents        QuoteEvent[]

  @@index([role, isActive])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id])
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  rotatedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

enum VatRate {
  GENERAL_19
  REDUCED_5
  EXEMPT
}

enum DocumentLocale {
  es
  en
}

/// Fila única (id = 1); los CHECK de rango viven en la migración.
model CompanySettings {
  id                   Int            @id @default(1)
  name                 String?        @db.VarChar(150)
  taxId                String?        @db.VarChar(30)
  address              String?        @db.VarChar(250)
  city                 String?        @db.VarChar(100)
  phone                String?        @db.VarChar(30)
  email                String?        @db.VarChar(150)
  website              String?        @db.VarChar(150)
  bankAccounts         String?        @db.Text
  commercialTerms      String?        @db.Text
  documentLocale       DocumentLocale @default(es)
  logoDataUrl          String?        @db.Text
  logoVersion          Int            @default(0)
  defaultVatRate       VatRate        @default(GENERAL_19)
  validityDays         Int            @default(15)
  discountLimitSeller  Decimal        @default(10) @db.Decimal(5, 2)
  discountLimitManager Decimal        @default(30) @db.Decimal(5, 2)
  discountLimitAdmin   Decimal        @default(30) @db.Decimal(5, 2)
  shippingTaxable      Boolean        @default(false)
  expiringAlertDays    Int            @default(3)
  followUpDays         Int            @default(5)
  coldStartThreshold   Int            @default(30)
  updatedAt            DateTime       @updatedAt
}

/// CHECK en la migración: phone IS NOT NULL OR email IS NOT NULL.
model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  nameKey     String   @db.VarChar(150)
  documentId  String   @unique @db.VarChar(20)
  phone       String?  @db.VarChar(15)
  email       String?  @db.VarChar(150)
  isActive    Boolean  @default(true)
  createdById String   @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  quotes      Quote[]

  @@index([isActive, nameKey])
  @@index([phone])
  @@index([email])
}

/// CHECK en la migración: price > 0.
model Product {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @db.VarChar(150)
  nameKey     String      @db.VarChar(150)
  category    String      @db.VarChar(80)
  categoryKey String      @db.VarChar(80)
  price       Decimal     @db.Decimal(15, 0)
  vatRate     VatRate
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  quoteItems  QuoteItem[]

  @@index([isActive, categoryKey])
  @@index([categoryKey])
  @@index([nameKey])
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  VOIDED
}

enum QuoteEventType {
  DISCOUNT_OVERRIDE
  EXPIRY_CHANGED
  REASSIGNED
  STATE_CHANGED
}

/// Contador del consecutivo; se incrementa con UPDATE ... RETURNING dentro de la transacción.
model QuoteSequence {
  key       String @id
  lastValue Int    @default(0)
}

/// CHECK en la migración: discountPct 0–100, shippingAmount >= 0, expiresAt obligatorio fuera de DRAFT.
model Quote {
  id              String         @id @default(uuid()) @db.Uuid
  number          Int            @unique
  customerId      String         @db.Uuid
  customer        Customer       @relation(fields: [customerId], references: [id])
  ownerId         String         @db.Uuid
  owner           User           @relation("QuoteOwner", fields: [ownerId], references: [id])
  createdById     String         @db.Uuid
  createdBy       User           @relation("QuoteCreator", fields: [createdById], references: [id])
  status          QuoteStatus    @default(DRAFT)
  discountPct     Decimal        @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal        @default(0) @db.Decimal(15, 0)
  shippingAmount  Decimal        @default(0) @db.Decimal(15, 0)
  shippingTaxable Boolean
  subtotal        Decimal        @db.Decimal(15, 0)
  linesVat        Decimal        @db.Decimal(15, 0)
  shippingVat     Decimal        @db.Decimal(15, 0)
  total           Decimal        @db.Decimal(15, 0)
  expiresAt       DateTime?      @db.Date
  sentAt          DateTime?
  firstSentAt     DateTime?
  approvedAt      DateTime?
  currentVersion  Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  items           QuoteItem[]
  versions        QuoteVersion[]
  events          QuoteEvent[]

  @@index([ownerId, status])
  @@index([status, expiresAt])
  @@index([firstSentAt])
  @@index([customerId])
  @@index([updatedAt])
}

/// CHECK en la migración: quantity > 0.
model QuoteItem {
  id          String  @id @default(uuid()) @db.Uuid
  quoteId     String  @db.Uuid
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String  @db.Uuid
  product     Product @relation(fields: [productId], references: [id])
  position    Int
  productName String  @db.VarChar(150)
  category    String  @db.VarChar(80)
  unitPrice   Decimal @db.Decimal(15, 0)
  vatRate     VatRate
  quantity    Decimal @db.Decimal(12, 2)
  lineAmount  Decimal @db.Decimal(15, 0)

  @@unique([quoteId, productId])
  @@index([quoteId])
}

model QuoteVersion {
  id              String   @id @default(uuid()) @db.Uuid
  quoteId         String   @db.Uuid
  quote           Quote    @relation(fields: [quoteId], references: [id])
  number          Int
  snapshot        Json
  changes         Json?
  customerRequest String?  @db.VarChar(1000)
  authorId        String   @db.Uuid
  author          User     @relation(fields: [authorId], references: [id])
  createdAt       DateTime @default(now())

  @@unique([quoteId, number])
}

model QuoteEvent {
  id        String         @id @default(uuid()) @db.Uuid
  quoteId   String         @db.Uuid
  quote     Quote          @relation(fields: [quoteId], references: [id])
  type      QuoteEventType
  /// null = sistema (job de vencimiento)
  actorId   String?        @db.Uuid
  actor     User?          @relation(fields: [actorId], references: [id])
  versionId String?        @db.Uuid
  note      String?        @db.VarChar(1000)
  data      Json
  createdAt DateTime       @default(now())

  @@index([quoteId, createdAt])
}
