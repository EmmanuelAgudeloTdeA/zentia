generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SELLER
  MANAGER
  ADMIN
}

model User {
  id                 String         @id @default(uuid()) @db.Uuid
  email              String         @unique
  name               String         @db.VarChar(120)
  passwordHash       String
  role               Role
  isActive           Boolean        @default(true)
  mustChangePassword Boolean        @default(true)
  passwordChangedAt  DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  refreshTokens      RefreshToken[]
  customers          Customer[]

  @@index([role, isActive])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id])
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  rotatedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

enum VatRate {
  GENERAL_19
  REDUCED_5
  EXEMPT
}

enum DocumentLocale {
  es
  en
}

/// Fila única (id = 1); los CHECK de rango viven en la migración.
model CompanySettings {
  id                   Int            @id @default(1)
  name                 String?        @db.VarChar(150)
  taxId                String?        @db.VarChar(30)
  address              String?        @db.VarChar(250)
  city                 String?        @db.VarChar(100)
  phone                String?        @db.VarChar(30)
  email                String?        @db.VarChar(150)
  website              String?        @db.VarChar(150)
  bankAccounts         String?        @db.Text
  commercialTerms      String?        @db.Text
  documentLocale       DocumentLocale @default(es)
  logoDataUrl          String?        @db.Text
  logoVersion          Int            @default(0)
  defaultVatRate       VatRate        @default(GENERAL_19)
  validityDays         Int            @default(15)
  discountLimitSeller  Decimal        @default(10) @db.Decimal(5, 2)
  discountLimitManager Decimal        @default(30) @db.Decimal(5, 2)
  discountLimitAdmin   Decimal        @default(30) @db.Decimal(5, 2)
  shippingTaxable      Boolean        @default(false)
  expiringAlertDays    Int            @default(3)
  followUpDays         Int            @default(5)
  coldStartThreshold   Int            @default(30)
  updatedAt            DateTime       @updatedAt
}

/// CHECK en la migración: phone IS NOT NULL OR email IS NOT NULL.
model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  nameKey     String   @db.VarChar(150)
  documentId  String   @unique @db.VarChar(20)
  phone       String?  @db.VarChar(15)
  email       String?  @db.VarChar(150)
  isActive    Boolean  @default(true)
  createdById String   @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, nameKey])
  @@index([phone])
  @@index([email])
}

/// CHECK en la migración: price > 0.
model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  nameKey     String   @db.VarChar(150)
  category    String   @db.VarChar(80)
  categoryKey String   @db.VarChar(80)
  price       Decimal  @db.Decimal(15, 0)
  vatRate     VatRate
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, categoryKey])
  @@index([categoryKey])
  @@index([nameKey])
}
